# Server-side calls from Next.js to FastAPI
API_URL=http://localhost:8000
# Browser calls (lead + post-property forms)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: shows a WhatsApp button on listing pages, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional: commercial OSM tile provider (defaults to the public OSM server, fine for development only)
NEXT_PUBLIC_TILE_URL=
